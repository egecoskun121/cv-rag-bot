{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "QaEvent",
  "type": "object",
  "properties": {
    "question": { "type": "string" },
    "retrievedSections": {
      "type": "array",
      "items": { "type": "string" }
    },
    "topScore": { "type": "number" },
    "answer": { "type": "string" },
    "latencyMs": { "type": "integer" },
    "timestamp": { "type": "string" }
  },
  "required": ["question", "answer"],
  "additionalProperties": false
}
